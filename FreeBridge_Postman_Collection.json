      "name": "1. Pruebas Funcionales",
      "item": [
        {
          "name": "1.1 Registro de Empresa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 500 (already exists)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 500]);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Response contains user id\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.usuario).to.have.property('id');",
                  "        pm.environment.set(\"empresa_user_id\", jsonData.usuario.id);",
                  "        // Guardar el correo para usar en login",
                  "        var requestBody = JSON.parse(pm.request.body.raw);",
                  "        pm.environment.set(\"empresa_correo\", requestBody.correo);",
                  "        console.log('Empresa registrada:', requestBody.correo);",
                  "    });",
                  "",
                  "    pm.test(\"User role is Empresa\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.usuario.rol).to.eql(\"Empresa\");",
                  "    });",
                  "} else {",
                  "    console.log('Usuario ya existe, usar correo existente');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tech Solutions S.A.\",\n  \"correo\": \"empresa{{$timestamp}}@techsolutions.com\",\n  \"contraseña\": \"Empresa123!\",\n  \"rol\": \"Empresa\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/registro",
              "host": ["{{base_url}}"],
              "path": ["registro"]
            }
          }
        },
        {
          "name": "1.2 Login Empresa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "});",
                  "",
                  "pm.test(\"Token is saved to environment\", function () {",
                  "    var token = pm.environment.get(\"token\");",
                  "    pm.expect(token).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{empresa_correo}}\",\n  \"contraseña\": \"Empresa123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "1.3 Crear Perfil Empresa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Status code is 201\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "",
                  "    pm.test(\"Company profile created successfully\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData).to.have.property('id_emp');",
                  "        pm.environment.set('empresa_id', jsonData.id_emp);",
                  "        console.log('✅ Empresa ID guardado:', jsonData.id_emp);",
                  "        console.log('⏸️ PAUSA: Ejecuta este SQL antes de continuar:');",
                  "        console.log('   INSERT INTO TokenBalance VALUES (UUID(), \\\"' + jsonData.id_emp + '\\\", 10, 0, 10);');",
                  "    });",
                  "} else if (pm.response.code === 400) {",
                  "    console.warn('⚠️ Perfil de empresa ya existe');",
                  "    console.log('🔍 Intentando obtener empresa_id existente...');",
                  "    ",
                  "    // Intentar obtener el ID de la empresa desde el usuario",
                  "    var empresaUserId = pm.environment.get('empresa_user_id');",
                  "    if (empresaUserId) {",
                  "        console.log('💡 Usa este GET para obtener el empresa_id:');",
                  "        console.log('   GET {{base_url}}/empresa/perfil/' + empresaUserId);",
                  "    }",
                  "} else {",
                  "    console.error('❌ ERROR inesperado:', pm.response.code, pm.response.json());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"NIT\": \"900{{$randomInt}}\",\n  \"tamaño\": \"Mediana\",\n  \"desc_emp\": \"Empresa de desarrollo de software y consultoría tecnológica\",\n  \"id_ciud\": 1,\n  \"id_usu\": \"{{empresa_user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/empresa/perfil",
              "host": ["{{base_url}}"],
              "path": ["empresa", "perfil"]
            }
          }
        },
        {
          "name": "1.4 Asignar Tokens a Empresa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Este test usa un pre-request script para insertar tokens via SQL",
                  "pm.test(\"Tokens assignment info\", function () {",
                  "    console.log('IMPORTANTE: Ejecutar SQL manualmente:');",
                  "    console.log('INSERT INTO TokenBalance (id_balance, id_emp, tokens_disponibles, tokens_usados, tokens_comprados)');",
                  "    console.log('VALUES (UUID(), \\\"' + pm.environment.get('empresa_id') + '\\\", 10, 0, 10);');",
                  "    pm.expect(pm.environment.get('empresa_id')).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Nota: Este es un placeholder. Los tokens deben asignarse manualmente via SQL",
                  "// o mediante un endpoint de compra de tokens si existe.",
                  "console.log('Empresa ID para asignar tokens:', pm.environment.get('empresa_id'));"
                ],
                "type": "text/javascript"
              }
            }
